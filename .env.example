# ==============================================================================
# Environment Configuration Template
# Copy this file to '.env' to override local defaults:
#   copy .env.example .env   (Windows)
#   cp .env.example .env     (Linux/macOS)
# ==============================================================================

# Base URL used for generated QR code verification links.
# Options:
# 1. Local testing on same machine (default):
#    BASE_URL=http://localhost:8000
#
# 2. Local testing with mobile phone connected to same Wi-Fi:
#    BASE_URL=http://192.168.1.9:8000
#
# 3. Production deployment (e.g. Render):
#    BASE_URL=https://<your-render-subdomain>.onrender.com

BASE_URL=http://192.168.1.9:8000
